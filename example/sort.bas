1 LET N = 20

10 DIM A(N)
11 FOR K=0 to N-1
12 LET A(K) = N - K
13 NEXT K

120 PRINT "BEFORE SORT\n"
130 FOR I = 0 TO N-1
140 PRINT A(I)
150 NEXT I

160 FOR P = 0 TO N-2
170 FOR J = 0 TO N-2
180 IF A(J) > A(J + 1) THEN 210
190 GOTO 260
210 LET T = A(J)
220 LET A(J) = A(J + 1)
230 LET A(J + 1) = T
260 NEXT J
270 NEXT P

280 PRINT "AFTER SORT\n"
290 FOR I = 0 TO N-1
300 PRINT A(I)
310 NEXT I