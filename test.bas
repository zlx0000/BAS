PRINT "GENERATING 2000 RANDOM VALUES\n"

LET TRUE = 1
LET FALSE = 0

LET SIZE = 2000
DIM A(2000)

LET SEED = 10279
LET MULTIPLIER = 25173
LET INCREMENT = 13849
LET MODULUS = 65536

FOR I = 0 TO SIZE - 1
    LET SEED = (MULTIPLIER * SEED + INCREMENT) % MODULUS
    LET A(I) = SEED
NEXT I

PRINT "FIRST 20 VALUES BEFORE SORTING\n"

FOR I = 0 TO 19
    PRINT A(I)
NEXT I

PRINT "SORTING\n"

FOR I = 0 TO SIZE - 2
    LET MININDEX = I

    FOR J = I + 1 TO SIZE - 1
        IF A(J) < A(MININDEX)
            LET MININDEX = J
        ELSE
            LET UNUSED = 0
        FI
    NEXT J

    IF MININDEX = I
        LET UNUSED = 0
    ELSE
        LET TEMP = A(I)
        LET A(I) = A(MININDEX)
        LET A(MININDEX) = TEMP
    FI
NEXT I

PRINT "FIRST 20 VALUES AFTER SORTING\n"

FOR I = 0 TO 19
    PRINT A(I)
NEXT I

PRINT "LAST 20 VALUES AFTER SORTING\n"

FOR I = SIZE - 20 TO SIZE - 1
    PRINT A(I)
NEXT I

PRINT "VERIFYING RESULT\n"

LET SORTED = TRUE

FOR I = 0 TO SIZE - 2
    IF A(I) <= A(I + 1)
        LET UNUSED = 0
    ELSE
        LET SORTED = FALSE
    FI
NEXT I

IF SORTED
    PRINT "ARRAY IS SORTED\n"
ELSE
    PRINT "SORT FAILED\n"
FI

