1000 LET N = 20000
1001 LET I = 0

1010 DIM A(N)

10 LET S=N
20 LET N0=2
30 IF N0>S THEN 10100
40 LET D=2
50 LET P=1
60 IF D*D>N0 THEN 150
70 IF N0%D=0 THEN 120
80 LET D=D+1
90 GOTO 60
120 LET P=0
150 IF P=1 THEN 180
160 LET N0=N0+1
170 GOTO 30
180 LET A(I)=N0
181 LET I=I+1
190 LET N0=N0+1
200 GOTO 30

10100 DIM A(I)
10101 LET N = I
10120 PRINT "BEFORE SORT"
10130 FOR I = 0 TO N-1
10140 PRINT A(I)
10150 NEXT I

10160 FOR P = 0 TO N-2
10170 FOR J = 0 TO N-2
10180 IF A(J) < A(J + 1) THEN 10210
10190 GOTO 10260
10210 LET T = A(J)
10220 LET A(J) = A(J + 1)
10230 LET A(J + 1) = T
10260 NEXT J
10270 NEXT P

10280 PRINT "AFTER SORT"
10290 FOR I = 0 TO N-1
10300 PRINT A(I)
10310 NEXT I

